{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "kURL",
  "version": "2.0.0",
  "description": "__MSG_extensionDescription__",
  "author": "Gerald Drißner",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "48": "images/kurl-icon-48.png",
    "96": "images/kurl-icon-96.png"
  },
  "background": {
    "service_worker": "JS/worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "kURL"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "activeTab",
    "tabs",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
